{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "opencoven",
  "homepage": "https://ui.opencoven.ai",
  "items": [
    {
      "name": "cn",
      "type": "registry:lib",
      "title": "Class name utility",
      "description": "Combines conditional classes and resolves Tailwind conflicts.",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "packages/ui/src/lib/utils.ts",
          "type": "registry:lib",
          "target": "@lib/utils.ts"
        }
      ]
    },
    {
      "name": "coven-theme",
      "type": "registry:theme",
      "title": "Coven semantic theme",
      "description": "Nova density, Zinc-seeded structure, lavender presence, and canonical tool-class tokens.",
      "files": [
        {
          "path": "packages/ui/src/styles/globals.css",
          "type": "registry:theme",
          "target": "src/styles/opencoven.css"
        }
      ],
      "meta": {
        "style": "base-nova",
        "baseColor": "zinc",
        "cssVariables": true,
        "density": [
          "default",
          "compact"
        ],
        "motion": "prefers-reduced-motion"
      }
    },
    {
