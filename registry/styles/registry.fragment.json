{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "coven-theme",
      "type": "registry:theme",
      "title": "Coven semantic theme",
      "description": "OpenCoven web profile v1.0.0 palette, typography, spacing, explicit density, and canonical tool-class tokens.",
      "files": [
        {
          "path": "../../packages/ui/src/styles/globals.css",
          "type": "registry:theme",
          "target": "src/styles/opencoven.css"
        }
      ],
      "meta": {
        "style": "base-nova",
        "baseColor": "zinc",
        "cssVariables": true,
        "density": ["default", "compact"],
        "motion": "prefers-reduced-motion"
      }
    }
  ]
}
